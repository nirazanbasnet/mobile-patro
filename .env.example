# Copy to .env and fill in.
#
# Everything with an EXPO_PUBLIC_ prefix is inlined into the app bundle at build
# time and is readable by anyone who downloads the app (a plain `strings` on the
# Hermes bundle recovers it). Never put a provider API key here — secrets belong
# in the ai-proxy Edge Function (see below).

# Full URL of the deployed ai-proxy function, e.g.
# https://<project-ref>.supabase.co/functions/v1/ai-proxy
EXPO_PUBLIC_AI_PROXY_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The Cerebras key is NOT set here. It lives server-side:
#   supabase secrets set CEREBRAS_API_KEY=<your key>
#   supabase functions deploy ai-proxy --no-verify-jwt
    